# =======================================================================
# CrowdSec -> BIRD bouncer configuration / Конфигурация bouncer
# Format: systemd EnvironmentFile / Формат: EnvironmentFile для systemd
# Recommended path / Рекомендуемый путь:
#   /etc/crowdsec/bird-bouncer.env
#
# Loaded by unit via EnvironmentFile= / Загружается unit-файлом через EnvironmentFile=.
# =======================================================================

# -------------------------- ОБЯЗАТЕЛЬНО --------------------------
# CrowdSec LAPI API key for this remediation component (bouncer).
# API-ключ CrowdSec LAPI для этого remediation component (bouncer).
# Generate key / Генерация ключа:
#   cscli bouncers add bird-stream-bouncer
CROWDSEC_API_KEY=REPLACE_WITH_REAL_BOUNCER_KEY

# ----------------------------- LAPI ------------------------------
# CrowdSec Local API base URL / Базовый URL CrowdSec Local API.
# Examples / Примеры:
#   http://127.0.0.1:8080
#   https://crowdsec.example.com:8080
CROWDSEC_BIRD_LAPI_URL=http://127.0.0.1:8080

# Component identity in HTTP User-Agent / Идентификация компонента в HTTP User-Agent.
CROWDSEC_BIRD_BOUNCER_NAME=bird-stream-bouncer
CROWDSEC_BIRD_BOUNCER_VERSION=1.0.0

# Single request timeout to LAPI, seconds / Таймаут одного запроса к LAPI, секунды.
CROWDSEC_BIRD_REQUEST_TIMEOUT=15

# Polling interval, seconds / Интервал polling-запросов, секунды.
# 30 = balanced, 10-15 = faster reaction / 30 = баланс, 10-15 = быстрее реакция.
CROWDSEC_BIRD_POLL_INTERVAL=30

# Usage metrics to CrowdSec LAPI (/v1/usage-metrics)
# Отправка usage-metrics в CrowdSec LAPI (/v1/usage-metrics)
CROWDSEC_BIRD_ENABLE_USAGE_METRICS=true
CROWDSEC_BIRD_USAGE_METRICS_INTERVAL=300
CROWDSEC_BIRD_USAGE_METRICS_TYPE=network
CROWDSEC_BIRD_USAGE_METRICS_NAME=bird-stream-bouncer

# ------------------------- ФИЛЬТР ПОТОКА -------------------------
# Scope list for /v1/decisions/stream / Список scopes для /v1/decisions/stream.
#   ip        - отдельные адреса (/32 или /128)
#   range     - сетевые префиксы
#   ip,range  - оба типа (рекомендуется)
CROWDSEC_BIRD_SCOPES=ip,range

# Allowed decision types (comma-separated) / Допустимые типы решений (через запятую).
CROWDSEC_BIRD_DECISION_TYPES=ban

# Origin filter (comma-separated), empty = all / Фильтр origin (через запятую), пусто = все.
# Examples / Примеры:
#   CAPI
#   crowdsec
#   cscli
#   crowdsec,cscli
CROWDSEC_BIRD_ALLOWED_ORIGINS=

# ------------------------ ОБРАБОТКА СЕТЕЙ ------------------------
# Address-family filter / Ограничение на семейство адресов:
# true  - обрабатывать только IPv4
# false - обрабатывать IPv4 и IPv6
CROWDSEC_BIRD_IPV4_ONLY=true

# Prefix normalization before writing BIRD config / Нормализация префиксов:
# 1.2.3.4/24 -> 1.2.3.0/24
CROWDSEC_BIRD_NORMALIZE_RANGES=true

# Drop private/local ranges (RFC1918, loopback, link-local, ULA, etc.)
# Отбрасывать приватные/локальные диапазоны (RFC1918, loopback, link-local, ULA и т.д.).
CROWDSEC_BIRD_BLOCK_PRIVATE_PREFIXES=true

# Minimum accepted prefix length / Минимальная допустимая длина префикса.
# v4: 24 -> допускаются /24-/32, более широкие (/23 и шире) отбрасываются.
# v6: 48 -> допускаются /48-/128.
CROWDSEC_BIRD_MIN_PREFIXLEN_V4=24
CROWDSEC_BIRD_MIN_PREFIXLEN_V6=48

# Hard limit for total announced prefixes (IPv4 + IPv6)
# Жесткий лимит общего количества анонсируемых префиксов (IPv4 + IPv6).
# 0 = лимит отключен.
CROWDSEC_BIRD_MAX_TOTAL_PREFIXES=30000

# ---------------------------- BIRD -------------------------------
# Auto-generated BIRD config fragments (must be included from main bird.conf)
# Автогенерируемые фрагменты конфигурации BIRD (должны include'иться в основном bird.conf)
CROWDSEC_BIRD_CONFIG_FILE_V4=/etc/bird/blackhole_dynamic_v4.conf
CROWDSEC_BIRD_CONFIG_FILE_V6=/etc/bird/blackhole_dynamic_v6.conf
# Disable IPv6 export / Отключить IPv6-выгрузку:
# CROWDSEC_BIRD_CONFIG_FILE_V6=

# Route type written to BIRD / Тип маршрута для BIRD:
#   blackhole (рекомендуется)
#   unreachable
#   prohibit
CROWDSEC_BIRD_BLACKHOLE_TYPE=blackhole

# Command to reload BIRD after file update / Команда применения конфигурации BIRD.
# Examples / Примеры:
#   /usr/sbin/birdc configure
#   /usr/sbin/birdc configure soft
CROWDSEC_BIRD_RELOAD_CMD=/usr/sbin/birdc configure soft

# Add BGP community directly into generated routes
# Добавлять BGP community непосредственно в генерируемые route-строки.
# Usually false if export filter sets community / Обычно false, если community ставит export-фильтр.
CROWDSEC_BIRD_ADD_COMMUNITY_IN_CONFIG_V4=false
CROWDSEC_BIRD_COMMUNITY_V4=65535:666
CROWDSEC_BIRD_ADD_COMMUNITY_IN_CONFIG_V6=false
CROWDSEC_BIRD_COMMUNITY_V6=65535:666

# ---------------------------- ЛОГИ -------------------------------
# Verbose logging / Подробное логирование.
# true  - логировать каждый опрос LAPI
# false - логировать только изменения и ошибки
CROWDSEC_BIRD_VERBOSE_NO_CHANGES=false
